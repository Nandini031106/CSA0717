#include <stdio.h>
#include <string.h>

int main() {
    char ip[20];

    printf("Enter IP address: ");
    scanf("%s", ip);

    if (strcmp(ip, "192.168.1.2") == 0)
        printf("MAC Address: AA:BB:CC:DD:EE:FF\n");
    else if (strcmp(ip, "192.168.1.3") == 0)
        printf("MAC Address: 11:22:33:44:55:66\n");
    else
        printf("MAC Address not found\n");

    return 0;
}
