#include <stdio.h>
#include <string.h>

int main() {
    char data[100], key[20];
    int i, j;

    printf("Enter data: ");
    scanf("%s", data);

    printf("Enter key: ");
    scanf("%s", key);

    int n = strlen(key);

    for(i = 0; i < n-1; i++)
        strcat(data, "0");

    for(i = 0; data[i+n-1]; i++) {
        if(data[i] == '1') {
            for(j = 0; j < n; j++)
                data[i+j] = (data[i+j] == key[j]) ? '0' : '1';
        }
    }

    printf("CRC: %s", data + strlen(data) - n + 1);

    return 0;
}
